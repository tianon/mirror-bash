#: builtins/caller.def:135
msgid ""
"Returns the context of the current subroutine call.\n"
"    \n"
"    Without EXPR, returns \"$line $filename\".  With EXPR, returns\n"
"    \"$line $subroutine $filename\"; this extra information can be used to\n"
"    provide a stack trace.\n"
"    \n"
"    The value of EXPR indicates how many call frames to go back before the\n"
"    current one; the top frame is frame 0.\n"
"    \n"
"    Exit Status:\n"
"    Returns 0 unless the shell is not executing a shell function or EXPR\n"
"    is invalid."
msgstr ""
"Atgriež pašreizējās apakšprogrammas izsaukuma kontekstu.\n"
"    \n"
"    Bez EXPR atgriež \"$line $filename\".  Ar EXPR atgriež\n"
"    \"$line $apakšprogramma $filename\"; šo papildu informāciju var izmantot,\n"
"    lai sniegtu steka izsekojumu.\n"
"    \n"
"    EXPR vērtība norāda, par cik izsaukumu kadriem jāatgriežas pirms\n"
"    pašreizējā; augšējais kadrs ir 0. kadrs.\n"
"    \n"
"    Izejas statuss:\n"
"    Atgriež 0, ja vien čaula neizpilda čaulas funkciju vai EXPR\n"
"    nav derīgs."

